# ─────────────────────────────────────────────────────────────────────────────
#  BASE DE DATOS
# ─────────────────────────────────────────────────────────────────────────────
# Opción A — Desarrollo local (MySQL en tu propio computador)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=fro_salud_db
DB_SSL=false

# Opción B — Base de datos en la nube.
# Casi todos los proveedores entregan una sola cadena de conexión. Si la pegas
# aquí, tiene prioridad y puedes ignorar las cinco variables de arriba.
# Recuerda poner DB_SSL=true cuando uses una base en la nube.
# DATABASE_URL=mysql://usuario:clave@host:puerto/nombre_base

# ─────────────────────────────────────────────────────────────────────────────
#  SERVIDOR
# ─────────────────────────────────────────────────────────────────────────────
# En la nube el proveedor asigna el puerto automáticamente; en local usa 3000.
PORT=3000

# Quién puede llamar a la API. Déjalo en * para desarrollo.
CORS_ORIGIN=*

# ─────────────────────────────────────────────────────────────────────────────
#  SEGURIDAD
# ─────────────────────────────────────────────────────────────────────────────
# Clave para firmar los tokens de sesión. En la nube DEBE ser una cadena larga
# y aleatoria, distinta a la de desarrollo. Puedes generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=xxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
#  CORREO (envío de códigos OTP)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Para que el envío de correos funcione, cada uno necesita generar su propia
# contraseña de aplicación de Google:
#
# 1. Entra a myaccount.google.com/apppasswords
# 2. Inicia sesión con tu cuenta Gmail
# 3. Si te pide activar la verificación en dos pasos, actívala en
#    myaccount.google.com → Seguridad
# 4. En "Nombre de la app" escribe Fro Salud y presiona Crear
# 5. Google te muestra una clave de 16 caracteres, cópiala
# 6. Ponla en SMTP_PASS junto con tu correo en SMTP_USER
#
# Cada uno usa su propio correo: no compartan credenciales.

# ─────────────────────────────────────────────────────────────────────────────
#  CLOUDINARY (repositorio multimedia de la ficha clínica — CU33/CU35)
# ─────────────────────────────────────────────────────────────────────────────
# El disco de Render es efímero (se borra en cada despliegue), por eso los
# archivos clínicos viven en Cloudinary. Los tres datos salen del Dashboard
# de cloudinary.com. En Render se cargan como variables de entorno.
CLOUDINARY_CLOUD_NAME=xxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
#  BREVO (envío de correo en la nube — OTP, recuperación de clave, CU42)
# ─────────────────────────────────────────────────────────────────────────────
# Render BLOQUEA los puertos SMTP (25, 465 y 587) en los servicios gratuitos
# desde el 26/09/2025, así que Gmail directo no funciona desplegado: falla con
# ETIMEDOUT o ENETUNREACH. Con estas variables el correo sale por HTTPS.
#
# Si BREVO_API_KEY está definida, se usa Brevo. Si no, se usa el SMTP de
# arriba (que sí sirve en desarrollo local y en instancias de pago).
#
# 1. Crear cuenta gratis en brevo.com (300 correos al día, sin tarjeta)
# 2. Senders, Domains & Dedicated IPs → Senders → Add a Sender:
#    poner el correo del proyecto y confirmarlo desde la bandeja de entrada
# 3. Copiar la clave desde SMTP & API → API Keys → Generate a new API key
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# Correo verificado en el paso 2. Si se omite, se usa SMTP_USER.
BREVO_SENDER=tucorreo@gmail.com
