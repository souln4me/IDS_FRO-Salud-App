{
  "expo": {
    "name": "Punto Paz Salud",
    "slug": "fro-salud-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-status-bar"
    ],
    "icon": "./assets/icono-app.png",
    "primaryColor": "#003B4D",
    "backgroundColor": "#FCFBF9",
    "splash": {
      "image": "./assets/icono-app.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono-adaptativo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/icono-app.png"
    }
  }
}
