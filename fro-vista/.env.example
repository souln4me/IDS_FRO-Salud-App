# Dirección del backend que usará la app.
#
# 1. Copia este archivo como .env  (en la misma carpeta fro-vista)
# 2. Pega la URL del backend en la nube que te compartió el equipo
# 3. Reinicia Expo con:  npx expo start -c   (la -c limpia la caché)
#
# Ejemplo con backend en la nube:
# EXPO_PUBLIC_API_URL=https://fro-salud-api.onrender.com
#
# Ejemplo trabajando con el backend en tu propio computador
# (reemplaza por la IP de TU máquina en la red local, no uses localhost:
#  el teléfono no encuentra "localhost" porque apunta al propio teléfono):
# EXPO_PUBLIC_API_URL=http://192.168.1.130:3000

EXPO_PUBLIC_API_URL=
